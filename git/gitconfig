[user]
	email = me@zhuorant.com
	name = Zhuoran Tan
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[rebase]
	autoStash = true
[core]
	excludesFile = ~/.gitignore
[init]
	defaultBranch = main
[include]
	path = ~/.gitconfig.local
[credential "https://github.com"]
	helper = "!f() { if command -v gh >/dev/null 2>&1; then gh auth git-credential \"$@\"; fi; }; f"
