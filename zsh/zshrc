# Codex starts its remote app server through an interactive SSH login shell
# without allocating a TTY. Terminal setup below writes escape sequences to
# stdout, which corrupts the app-server startup protocol. A tmux pane has a
# real stdout TTY even when it inherits an SSH environment without SSH_TTY,
# so keep its interactive setup while skipping genuinely headless sessions.
if [[ -n ${SSH_CONNECTION:-} && -z ${SSH_TTY:-} ]] && [[ ! -t 1 ]]; then
    return
fi

if [[ -n $GHOSTTY_RESOURCES_DIR ]]; then
    source "$GHOSTTY_RESOURCES_DIR"/shell-integration/zsh/ghostty-integration
fi

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# longer history
export HISTSIZE=1000000
export SAVEHIST=1000000


# ohmyzsh
export ZSH="${HOME}/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(alias-finder bun colored-man-pages docker docker-compose fzf gh git history kamal zoxide zsh-interactive-cd)
source ${ZSH}/oh-my-zsh.sh

BREWPREFIX="/opt/homebrew"

if [ -d "${BREWPREFIX}" ]; then
    source ${BREWPREFIX}/share/zsh-autosuggestions/zsh-autosuggestions.zsh
    source ${BREWPREFIX}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
    source ${BREWPREFIX}/share/powerlevel10k/powerlevel10k.zsh-theme
else
    if [ -d "/usr/share/zsh/plugins" ]; then
        source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
        source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
    else
        source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
        source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
    fi
    source /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme
fi

unset BREWPREFIX


# powerlevel10k
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh


# aliases
alias v=${VISUAL}
alias t='tmux new -As main'
alias c='codex'
alias lg='lazygit'
alias del='trash'

function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}



# Changes the cursor style to a blinking block in vi command mode
# and a blinking bar in insert mode. Resets to default for commands.
_zsh_cursor_style() {
  case ${KEYMAP} in
    vicmd|visual)
      # Blinking block cursor
      print -n '\e[1 q'
      ;;
    *)
      # Blinking bar cursor
      print -n '\e[5 q'
      ;;
  esac
}

# Resets the cursor to the terminal's default shape.
_zsh_cursor_reset() {
  print -n '\e[0 q'
}

zle -N zle-line-init _zsh_cursor_style
zle -N zle-keymap-select _zsh_cursor_style

# Add the functions to the appropriate hooks.
autoload -U add-zsh-hook
add-zsh-hook preexec _zsh_cursor_reset

# Set the initial cursor style upon loading.
_zsh_cursor_style
